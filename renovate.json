{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",

  "nix": {
    "enabled": false
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OCI container images in .nix files",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "(?:# renovate: (?:versioning=(?<versioning>[^\\s]+)\\s+)?(?:extractVersion=(?<extractVersion>[^\\s]+)\\s*)?)?image\\s*=\\s*\"(?<depName>[^:\"]+):(?<currentValue>[^\"\\s]+)\"\\s*;"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}",
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{/if}}"
    }
  ],

  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "automerge": true
    },
    {
      "matchDatasources": ["github-actions"],
      "automerge": false
    }
  ]
}
