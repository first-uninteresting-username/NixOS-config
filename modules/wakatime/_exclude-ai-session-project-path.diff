+func TestWithAIFiltering_ExcludesSessionHeartbeatsByProjectPath(t *testing.T) {
+	excluded := heartbeat.Heartbeat{
+		Entity: "Claude 1", EntityType: heartbeat.AppType, Category: "ai coding",
+		ProjectPathOverride: "/home/u/Projects/app",
+	}
+	allowed := heartbeat.Heartbeat{
+		Entity: "Claude 2", EntityType: heartbeat.AppType, Category: "ai coding",
+		ProjectPathOverride: "/home/u/Agents/app",
+	}
+	noPath := heartbeat.Heartbeat{Entity: "Claude 3", EntityType: heartbeat.AppType, Category: "ai coding"}
+	cfg := ai.Config{Exclude: []regex.Regex{regex.MustCompile(`^(?!/home/u/Agents(/|$))`)}}
+	_, err := ai.WithFiltering(cfg)(func(_ context.Context, got []heartbeat.Heartbeat) ([]heartbeat.Result, error) {
+		assert.Equal(t, []heartbeat.Heartbeat{allowed, noPath}, got)
+		return nil, nil
+	})(t.Context(), []heartbeat.Heartbeat{excluded, allowed, noPath})
+	require.NoError(t, err)
+}
